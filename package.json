{
  "name": "@x-wp/wordpack",
  "description": "Front-end bundler toolkit for WordPress themes & plugins",
  "version": "0.0.0-development",
  "license": "MIT",
  "author": "Sibin Grasic <sibin.grasic@oblak.studio> (https://oblak.studio)",
  "keywords": [
    "wordpack",
    "wpwebpack",
    "WP webpack",
    "WordPress webpack",
    "Install wpwebpack",
    "Webpack with WordPress",
    "Webpack for WordPress"
  ],
  "homepage": "https://wordpack.js.org",
  "repository": "github:x-wp/wordpack",
  "bugs": {
    "url": "https://github.com/x-wp/wordpack/issues",
    "email": "podrska@oblak.studio"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "watch": "rm -rf dist && tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint lib --ext .ts",
    "lint:fix": "eslint lib --ext .ts --fix",
    "format": "prettier --write lib",
    "format:check": "prettier --check lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixture": "tsx ./node_modules/webpack/bin/webpack.js --config test/webpack.config.ts --env basePath=./test",
    "test:fixture:prod": "tsx ./node_modules/webpack/bin/webpack.js --config test/webpack.config.ts --env production basePath=./test",
    "test:fixture:watch": "tsx ./node_modules/webpack/bin/webpack.js --config test/webpack.config.ts --watch --env basePath=./test"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@swc/core": "^1.15.33",
    "@x-wp/friendly-errors-webpack-plugin": "^2.1.0",
    "browserslist": "^4.28.2",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.49.0",
    "css-loader": "^7.1",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "css-url-relative-plugin": "^1.1.0",
    "cssnano": "^7.0",
    "image-minimizer-webpack-plugin": "^4.1",
    "mini-css-extract-plugin": "^2.9",
    "postcss": "^8.4",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^9.5.13",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.79",
    "sass-loader": "^16",
    "sharp": "^0.33",
    "svgo": "^3.3",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.3.10",
    "tsx": "^4.21.0",
    "webpack-assets-manifest": "^5.2.1",
    "webpack-merge": "^6.0",
    "webpack-remove-empty-scripts": "^1.0.4",
    "webpackbar": "^6.0.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/sass-loader": "^8.0",
    "@types/webpack": "^5.28.5",
    "@types/webpack-assets-manifest": "^5.1.4",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "sass-embedded": "^1.79.1",
    "typescript": "^5.4.5",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.5",
    "webpack": "^5.94",
    "webpack-cli": "^5.1"
  },
  "optionalDependencies": {
    "sass-embedded": "^1.79"
  },
  "peerDependencies": {
    "webpack": "^5.94",
    "webpack-cli": "^5.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
